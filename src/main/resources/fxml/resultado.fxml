<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla de fin de partida -->
<VBox alignment="CENTER" spacing="20.0" prefWidth="420.0" prefHeight="360.0"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ar.edu.unlu.mayormenor.vista.ResultadoController"
      stylesheets="@../styles/juego.css" styleClass="mesa">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>
    <Label fx:id="lblMensaje" text="Perdiste." style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
    <Label fx:id="lblPuntaje" text="Puntaje: 0" style="-fx-font-size: 18px;"/>
    <HBox alignment="CENTER" spacing="15.0">
        <Button fx:id="btnJugarDeNuevo" text="Jugar de nuevo" onAction="#onJugarDeNuevo"/>
        <Button fx:id="btnVolver" text="Volver al menú" onAction="#onVolver"/>
    </HBox>
</VBox>
